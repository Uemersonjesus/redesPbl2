# ═══════════════════════════════════════════════════════════════════
# .env — Configuração completa do sistema REDESPBL22026
# Copie para .env e ajuste os IPs da sua LAN:
#   cp .env.completo .env
#
# Após preencher, todos os comandos ficam simples:
#   docker compose -f docker-compose.broker1.yml up --build
#   docker compose -f docker-compose.sensor.yml up --build
#   docker compose -f docker-compose.drone.yml up --build
# ═══════════════════════════════════════════════════════════════════

# ── IPs dos brokers ─────────────────────────────────────────────────
# Se dois brokers estão no mesmo PC, use o mesmo IP com portas diferentes
B1_IP=192.168.1.10
B2_IP=192.168.1.10
B3_IP=192.168.1.11

# ── IPs dos sensores ─────────────────────────────────────────────────
# Cada setor pode estar em uma máquina diferente
SENSOR_NORTE_IP=192.168.1.20
SENSOR_CENTRO_IP=192.168.1.21
SENSOR_SUL_IP=192.168.1.22

# ── IP da máquina dos drones ──────────────────────────────────────────
# Para o broker chamar o drone de volta via RPC.
# MESMO PC: deixe comentado — o drone usará seu hostname Docker automaticamente
# PC DIFERENTE: defina com o IP real da máquina dos drones
# DRONE_HOST_IP=192.168.1.30

# ── Configurações do drone individual ────────────────────────────────
# Mude estes valores antes de subir cada drone
DRONE_ID=drone-1
DRONE_RPC_PORT=7101
LAT_INICIAL=26.60
LONG_INICIAL=56.20

# ── Configurações do sensor individual ───────────────────────────────
# Mude estes valores antes de subir cada sensor
SENSOR_ID=norte-radar-1
SETOR_ID=setor-norte
TIPO=radar
LAT=26.65
LONG=56.15

# ── Log dos brokers ───────────────────────────────────────────────────
# normal = painel a cada 5s | verbose = mostra cada mensagem individual
BROKER_LOG_LEVEL=normal

DRONE_HOST_IP=192.168.100.64