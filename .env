
#As variaveis estão assim devido aos testes para fazer funcionar na lan
#ms isso não foi finalizado e o projeto apenas funciona em um pc 
#Sendo que é necessário subir os brokers primeiro.
# ── IPs dos brokers ─────────────────────────────────────────────────
# Se dois brokers estão no mesmo PC, use o mesmo IP com portas diferentes
B1_IP=192.168.100.64
B2_IP=192.168.100.64
B3_IP=192.168.100.64

# ── IPs dos sensores ─────────────────────────────────────────────────
SENSOR_NORTE_IP=192.168.100.64
SENSOR_CENTRO_IP=192.168.100.64
SENSOR_SUL_IP=192.168.100.64

# ── IP da máquina dos drones ──────────────────────────────────────────
# Para o broker chamar o drone de volta via RPC.
# MESMO PC: deixe comentado — o drone usará seu hostname Docker automaticamente
# PC DIFERENTE: defina com o IP real da máquina dos drones
# DRONE_HOST_IP=192.168.1.30

# ── Configurações do drone individual ────────────────────────────────

DRONE_ID=drone-1
DRONE_RPC_PORT=7101
LAT_INICIAL=26.60
LONG_INICIAL=56.20



# ── Configurações do sensor individual ───────────────────────────────
SENSOR_ID=norte-radar-1
SETOR_ID=setor-norte
TIPO=radar
LAT=26.65
LONG=56.15

# ── Log dos brokers ───────────────────────────────────────────────────
# normal = painel a cada 5s | verbose = mostra cada mensagem individual
BROKER_LOG_LEVEL=normal
